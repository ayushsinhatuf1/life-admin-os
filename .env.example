# ---- backend ----
APP_ENV=development
SECRET_KEY=generate-with-"openssl rand -hex 32"
ACCESS_TOKEN_MINUTES=30

DATABASE_URL=postgresql+psycopg://lifeadmin:lifeadmin@localhost:5432/lifeadmin

# MinIO locally; S3 / Cloudflare R2 / Wasabi in production. Bucket must be private.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=life-admin-documents
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-sonnet-4-6
ASSISTANT_MODEL=claude-sonnet-4-6

MAX_UPLOAD_MB=25
ALLOWED_MIME=application/pdf,image/jpeg,image/png

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=reminders@lifeadminos.app

# ---- frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
